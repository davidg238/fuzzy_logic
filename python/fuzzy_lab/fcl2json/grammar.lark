// FCL grammar — covers the subset used by every .fcl file in fcl/.
// Engine-honored operators (AND/OR/ACT/ACCU/METHOD) are parsed into their own
// rules so parse_fcl can raise on non-default values rather than silently
// discarding them. Cosmetic metadata (RANGE/DEFAULT) is still accepted and
// discarded — neither affects the math the engine runs.
//
// Extensions beyond the plan template (found by surveying all 12 .fcl files):
//   - Trapezoid / Triangle: case-insensitive full-word aliases for trape/trian
//     (tipping2.fcl, generated by fuzzylite 6.0)
//   - gbell a b c / gauss a b / sigm a b: extra membership function types
//     (membershipFunctionsDemo.fcl, qualify.fcl)
//   - RANGE := (num .. num): fuzzify/defuzzify metadata, accepted-and-discarded
//     (tipping2.fcl, qualify_optimized.fcl)
//   - DEFAULT := nan: "nan" accepted as a numeric value
//     (tipping2.fcl)
//   - ACCU inside DEFUZZIFY: accepted-and-discarded (qualify.fcl, qualify_optimized.fcl)
//   - Rule (mixed-case): RULE keyword matched case-insensitively (tipping.fcl)
//   - Rules without trailing semicolons: semicolon is optional (tipping2.fcl)
//   - NOT at start of expression before parenthesised group: handled by not_expr (qualify.fcl, qualify_optimized.fcl)
//   - membershipFunctionsDemo.fcl has no RULEBLOCK: _block_body allows ruleblock*

function_block: "FUNCTION_BLOCK"i NAME _block_body "END_FUNCTION_BLOCK"i

_block_body: (var_input | var_output | fuzzify | defuzzify | ruleblock)*

var_input:  "VAR_INPUT"i  var_decl* "END_VAR"i
var_output: "VAR_OUTPUT"i var_decl* "END_VAR"i
var_decl: NAME ":" "REAL"i ";"

fuzzify:   "FUZZIFY"i   NAME (term_decl | range_decl)* "END_FUZZIFY"i
defuzzify: "DEFUZZIFY"i NAME (term_decl | defuzzify_extra | range_decl)* "END_DEFUZZIFY"i

defuzzify_extra: method_decl | default_decl | act_decl | accu_decl
method_decl:  "METHOD"i  ":" NAME ";"
default_decl: "DEFAULT"i ":=" (SIGNED_NUMBER | "nan"i) ";"

// range_decl: accept-and-discard metadata (e.g. "RANGE := (0.0 .. 10.0);")
range_decl: "RANGE"i ":=" "(" SIGNED_NUMBER ".." SIGNED_NUMBER ")" ";"

term_decl: "TERM"i NAME ":=" term_body ";"

term_body: term_trape
         | term_trian
         | term_points
         | term_singleton
         | term_gbell
         | term_gauss
         | term_sigm

// trape and trian: lowercase canonical, Trapezoid/Triangle: fuzzylite aliases
term_trape:     ("trape"i | "Trapezoid"i) SIGNED_NUMBER SIGNED_NUMBER SIGNED_NUMBER SIGNED_NUMBER
term_trian:     ("trian"i | "Triangle"i)  SIGNED_NUMBER SIGNED_NUMBER SIGNED_NUMBER
term_gbell:     "gbell"i  SIGNED_NUMBER SIGNED_NUMBER SIGNED_NUMBER
term_gauss:     "gauss"i  SIGNED_NUMBER SIGNED_NUMBER
term_sigm:      "sigm"i   SIGNED_NUMBER SIGNED_NUMBER
term_points:    point+
term_singleton: SIGNED_NUMBER
point: "(" SIGNED_NUMBER "," SIGNED_NUMBER ")"

ruleblock: "RULEBLOCK"i NAME ruleblock_extra* rule* "END_RULEBLOCK"i
ruleblock_extra: and_decl | or_decl | act_decl | accu_decl
and_decl:  "AND"i  ":" NAME ";"
or_decl:   "OR"i   ":" NAME ";"
act_decl:  "ACT"i  ":" NAME ";"
accu_decl: "ACCU"i ":" NAME ";"

// RULE keyword is matched case-insensitively (some files use "Rule").
// Trailing ";" is optional (tipping2.fcl omits it).
rule: "RULE"i RULE_ID ":" "IF"i expr "THEN"i consequent_list ("WITH"i SIGNED_NUMBER)? ";"?
RULE_ID: /[A-Za-z0-9_]+/

?expr: or_expr
?or_expr:  and_expr ("OR"i and_expr)*           -> or_expr
?and_expr: not_expr ("AND"i not_expr)*          -> and_expr
?not_expr: "NOT"i atom                          -> not_expr
         | atom
?atom: "(" expr ")"
     | is_not_expr
     | is_expr
is_expr:     NAME "IS"i NAME
is_not_expr: NAME "IS"i "NOT"i NAME

consequent_list: consequent ("," consequent)*
consequent: NAME "IS"i NAME

NAME: /[A-Za-z_][A-Za-z0-9_]*/

%import common.SIGNED_NUMBER
%import common.WS
%ignore WS
%ignore /\/\/[^\n]*/        // line comments
%ignore /\/\*(.|\n)*?\*\//  // block comments
