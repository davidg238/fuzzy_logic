{
  "name": "driver_advanced",
  "defuzz_method": "COG",
  "inputs": [
    {
      "name": "distance",
      "terms": [
        {
          "name": "near",
          "a": 0,
          "b": 20,
          "c": 20,
          "d": 40
        },
        {
          "name": "safe",
          "a": 30,
          "b": 50,
          "c": 50,
          "d": 70
        },
        {
          "name": "distant",
          "a": 60,
          "b": 80,
          "c": 100,
          "d": 100
        }
      ]
    },
    {
      "name": "speed",
      "terms": [
        {
          "name": "stpd",
          "a": 0,
          "b": 0,
          "c": 0,
          "d": 0
        },
        {
          "name": "slow",
          "a": 1,
          "b": 10,
          "c": 10,
          "d": 20
        },
        {
          "name": "norm",
          "a": 15,
          "b": 30,
          "c": 30,
          "d": 50
        },
        {
          "name": "quick",
          "a": 45,
          "b": 60,
          "c": 70,
          "d": 70
        }
      ]
    },
    {
      "name": "temperature",
      "terms": [
        {
          "name": "cold",
          "a": 0,
          "b": 0,
          "c": 1,
          "d": 14
        },
        {
          "name": "good",
          "a": 5,
          "b": 32,
          "c": 32,
          "d": 59
        },
        {
          "name": "hot",
          "a": 50,
          "b": 68,
          "c": 86,
          "d": 86
        }
      ]
    }
  ],
  "outputs": [
    {
      "name": "risk",
      "terms": [
        {
          "name": "min",
          "a": 0,
          "b": 20,
          "c": 20,
          "d": 40
        },
        {
          "name": "avg",
          "a": 30,
          "b": 50,
          "c": 50,
          "d": 70
        },
        {
          "name": "max",
          "a": 60,
          "b": 80,
          "c": 80,
          "d": 100
        }
      ]
    },
    {
      "name": "throttle",
      "terms": [
        {
          "name": "sptd_o",
          "a": 0,
          "b": 0,
          "c": 0,
          "d": 0
        },
        {
          "name": "slow_o",
          "a": 1,
          "b": 10,
          "c": 10,
          "d": 20
        },
        {
          "name": "norm_o",
          "a": 15,
          "b": 30,
          "c": 30,
          "d": 50
        },
        {
          "name": "quick_o",
          "a": 45,
          "b": 60,
          "c": 70,
          "d": 70
        }
      ]
    }
  ],
  "rules": [
    {
      "name": "R1: distance is near OR speed is quick OR temperature is cold \u2192 risk is max",
      "if": {
        "op": "or",
        "args": [
          {
            "op": "or",
            "args": [
              {
                "op": "is",
                "var": "distance",
                "term": "near"
              },
              {
                "op": "is",
                "var": "speed",
                "term": "quick"
              }
            ]
          },
          {
            "op": "is",
            "var": "temperature",
            "term": "cold"
          }
        ]
      },
      "then": [
        {
          "var": "risk",
          "term": "max"
        }
      ]
    },
    {
      "name": "R2: distance is safe AND speed is norm OR temperature is good \u2192 risk is avg, throttle is norm_o",
      "if": {
        "op": "or",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "op": "is",
                "var": "distance",
                "term": "safe"
              },
              {
                "op": "is",
                "var": "speed",
                "term": "norm"
              }
            ]
          },
          {
            "op": "is",
            "var": "temperature",
            "term": "good"
          }
        ]
      },
      "then": [
        {
          "var": "risk",
          "term": "avg"
        },
        {
          "var": "throttle",
          "term": "norm_o"
        }
      ]
    },
    {
      "name": "R3: distance is distant AND speed is slow OR temperature is hot \u2192 risk is min, throttle is quick_o",
      "if": {
        "op": "or",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "op": "is",
                "var": "distance",
                "term": "distant"
              },
              {
                "op": "is",
                "var": "speed",
                "term": "slow"
              }
            ]
          },
          {
            "op": "is",
            "var": "temperature",
            "term": "hot"
          }
        ]
      },
      "then": [
        {
          "var": "risk",
          "term": "min"
        },
        {
          "var": "throttle",
          "term": "quick_o"
        }
      ]
    }
  ]
}