        {
          "name": "lowHumidity",
          "a": 30,
          "b": 45,
          "c": 45,
          "d": 60
        },
        {
          "name": "medium",
          "a": 50,
          "b": 65,
          "c": 65,
          "d": 80
        },
        {
          "name": "fast",
          "a": 70,
          "b": 90,
          "c": 95,
          "d": 95
        }
      ]
    }
  ],
  "rules": [
