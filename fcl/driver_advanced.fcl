// Hand-coded counterpart in examples/models.toit (get-driver-advanced).
// 3 inputs, 2 outputs, 3 rules with nested OR/AND and multi-output consequents.

FUNCTION_BLOCK driver_advanced
VAR_INPUT
  distance:    REAL;
  speed:       REAL;
  temperature: REAL;
END_VAR

VAR_OUTPUT
  risk:     REAL;
  throttle: REAL;
END_VAR

FUZZIFY distance
  // near:    trian 0 20 40
  // safe:    trian 30 50 70
  // distant: FuzzySet 60 80 100 100 (RTrap)
  TERM near    := trian  0 20 40;
  TERM safe    := trian 30 50 70;
  TERM distant := (60, 0) (80, 1) (100, 1);
END_FUZZIFY

FUZZIFY speed
  // stpd:  singleton at 0
  // slow:  trian 1 10 20
  // norm:  trian 15 30 50
  // quick: FuzzySet 45 60 70 70 (RTrap)
  TERM stpd  := 0;
  TERM slow  := trian  1 10 20;
  TERM norm  := trian 15 30 50;
  TERM quick := (45, 0) (60, 1) (70, 1);
END_FUZZIFY

FUZZIFY temperature
  // cold: FuzzySet 0 0 1 14 (LTrap: a==b<c<d)
  // good: trian 5 32 59
  // hot:  FuzzySet 50 68 86 86 (RTrap)
  TERM cold := ( 0, 1) ( 1, 1) (14, 0);
  TERM good := trian 5 32 59;
  TERM hot  := (50, 0) (68, 1) (86, 1);
END_FUZZIFY

DEFUZZIFY risk
  // min: trian 0 20 40
  // avg: trian 30 50 70
  // max: trian 60 80 100
  TERM min := trian  0 20  40;
  TERM avg := trian 30 50  70;
  TERM max := trian 60 80 100;
  METHOD: COG;
  DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY throttle
  // sptd_o:  singleton at 0
  // slow_o:  trian 1 10 20
  // norm_o:  trian 15 30 50
  // quick_o: FuzzySet 45 60 70 70 (RTrap)
  TERM sptd_o  := 0;
  TERM slow_o  := trian  1 10 20;
  TERM norm_o  := trian 15 30 50;
  TERM quick_o := (45, 0) (60, 1) (70, 1);
  METHOD: COG;
  DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK No1
  AND : MIN;
  // Rule 0 (hand-coded): fl-or (fl-or near quickInput) (fl-set cold) -> risk = max
  RULE 1: IF distance IS near OR speed IS quick OR temperature IS cold THEN risk IS max;
  // Rule 1: fl-or (fl-and safe normalInput) good -> [risk = avg, throttle = norm_o]
  RULE 2: IF (distance IS safe AND speed IS norm) OR temperature IS good THEN risk IS avg, throttle IS norm_o;
  // Rule 2: fl-or (fl-and distant slowInput) hot -> [risk = min, throttle = quick_o]
  RULE 3: IF (distance IS distant AND speed IS slow) OR temperature IS hot THEN risk IS min, throttle IS quick_o;
END_RULEBLOCK
END_FUNCTION_BLOCK
